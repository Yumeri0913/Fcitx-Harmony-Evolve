+std::string PinyinEngine::importGooglePinyinWords(const std::string &tsv) {
+    auto result = googlepinyin::mergeIntoUserData(
+        *ime_->dict(), ime_->model()->history(), googlepinyin::fromTsv(tsv));
+    save();
+    return std::to_string(result.added) + " " +
+           std::to_string(result.existing) + " " +
+           std::to_string(result.invalid);
+}
+
+std::string PinyinEngine::exportGooglePinyinWords() {
+    return googlepinyin::toTsv(googlepinyin::readUserWords(
+        *ime_->dict(), &ime_->model()->history()));
+}
