+/*
+ * SPDX-FileCopyrightText: 2026 Fcitx5 for Android Contributors
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ *
+ */
+#ifndef _PINYIN_GOOGLEPINYIN_PUBLIC_H_
+#define _PINYIN_GOOGLEPINYIN_PUBLIC_H_
+
+#include <string>
+#include <fcitx/addoninstance.h>
+
+// Exchange user words with Google Pinyin user dictionaries, see
+// googlepinyin_userdata.h. Words are UTF-8 lines of "word\tpin'yin\tcount".
+
+// Merge words into the running engine's user dict and history, then save.
+// Returns "added existing invalid".
+FCITX_ADDON_DECLARE_FUNCTION(PinyinEngine, importGooglePinyinWords,
+                             std::string(const std::string &tsv));
+
+// All words of the user dict, with usage counts from history.
+FCITX_ADDON_DECLARE_FUNCTION(PinyinEngine, exportGooglePinyinWords,
+                             std::string());
+
+// Merge what was typed for each word ("code\tword\tcount" lines, into
+// pinyin/user.typed) and English words ("word\tcount" lines, into
+// pinyin/user.english), keeping the larger count, then save. Returns
+// "typed english", the number of valid lines of each.
+FCITX_ADDON_DECLARE_FUNCTION(PinyinEngine, importGooglePinyinLearned,
+                             std::string(const std::string &typed,
+                                         const std::string &english));
+
+// Learned English words, "word\tcount\tstamp" lines like pinyin/user.english.
+FCITX_ADDON_DECLARE_FUNCTION(PinyinEngine, exportLearnedEnglish, std::string());
+
+#endif // _PINYIN_GOOGLEPINYIN_PUBLIC_H_
