+std::string
+PinyinEngine::importGooglePinyinLearned(const std::string &typed,
+                                        const std::string &english) {
+    auto parseCount = [](const std::string &s) -> uint32_t {
+        try {
+            return static_cast<uint32_t>(
+                std::min<unsigned long>(std::stoul(s), 0xffffff));
+        } catch (...) {
+            return 0;
+        }
+    };
+    // Imported entries were not committed here: stamp 0, no boost as recent
+    // commits. load() keeps the larger count of an entry already there.
+    size_t typedAdded = 0;
+    std::stringstream table;
+    typedHistory_.save(table);
+    for (const auto &line : stringutils::split(typed, "\n")) {
+        auto f = stringutils::split(line, "\t");
+        if (f.size() < 3) {
+            continue;
+        }
+        const auto count = parseCount(f[2]);
+        if (count == 0 ||
+            !TypedCodeHistory::isValid(TypedCodeHistory::key(f[0]), f[1])) {
+            continue;
+        }
+        table << f[0] << '\t' << f[1] << '\t' << count << "\t0\n";
+        typedAdded++;
+    }
+    typedHistory_.load(table);
+
+    // Learned English words, lines of word<TAB>count<TAB>stamp, by lowercase
+    // word; imported words count as used just now, the larger count wins.
+    struct English {
+        std::string word;
+        uint32_t count;
+        uint64_t stamp;
+    };
+    std::vector<English> words;
+    std::unordered_map<std::string, size_t> index;
+    uint64_t stamp = 0;
+    std::stringstream saved;
+    englishWords_.save(saved);
+    std::string line;
+    while (std::getline(saved, line)) {
+        auto f = stringutils::split(line, "\t");
+        if (f.size() < 3) {
+            continue;
+        }
+        English w{f[0], parseCount(f[1]), 0};
+        try {
+            w.stamp = std::stoull(f[2]);
+        } catch (...) {
+        }
+        stamp = std::max(stamp, w.stamp);
+        index[EnglishUserWords::normalize(w.word)] = words.size();
+        words.push_back(std::move(w));
+    }
+    size_t englishAdded = 0;
+    for (const auto &line : stringutils::split(english, "\n")) {
+        auto f = stringutils::split(line, "\t");
+        if (f.size() < 2 || !EnglishUserWords::isLearnable(f[0])) {
+            continue;
+        }
+        const auto count =
+            std::min<uint32_t>(parseCount(f[1]), EnglishUserWords::MaxCount);
+        if (count == 0) {
+            continue;
+        }
+        englishAdded++;
+        auto key = EnglishUserWords::normalize(f[0]);
+        if (auto iter = index.find(key); iter != index.end()) {
+            words[iter->second].count =
+                std::max(words[iter->second].count, count);
+            continue;
+        }
+        index[key] = words.size();
+        words.push_back({f[0], count, ++stamp});
+    }
+    std::stringstream merged;
+    for (const auto &w : words) {
+        merged << w.word << '\t' << w.count << '\t' << w.stamp << '\n';
+    }
+    englishWords_.load(merged);
+
+    save();
+    return std::to_string(typedAdded) + " " + std::to_string(englishAdded);
+}
