+void PinyinEngine::forgetLearnedWord(InputContext *inputContext,
+                                     const std::string &word) {
+    auto *state = inputContext->propertyFor(&factory_);
+    englishWords_.remove(word);
+    typedHistory_.remove(std::string_view(state->context_.userInput())
+                             .substr(state->context_.selectedLength()),
+                         word);
+    // The pinyin candidate hidden behind it was learned from the same commits:
+    // forget that too, or it stays on top.
+    const auto &sentences = state->context_.candidatesToCursor();
+    for (size_t i = 0; i < sentences.size(); i++) {
+        if (sentences[i].toString() == word) {
+            forgetCandidate(inputContext, i);
+            return;
+        }
+    }
