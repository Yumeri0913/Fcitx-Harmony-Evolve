new file mode 100644
index 0000000..d90ada9
--- /dev/null
+++ b/im/pinyin/typedcodehistory.h
@@ -0,0 +1,291 @@
+/*
+ * SPDX-FileCopyrightText: 2026-2026 Fcitx5 for Android Contributors
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ *
+ */
+#ifndef _PINYIN_TYPEDCODEHISTORY_H_
+#define _PINYIN_TYPEDCODEHISTORY_H_
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <istream>
+#include <ostream>
+#include <string>
+#include <string_view>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace fcitx {
+
+// What the user committed for exactly what they typed, and how often, like the
+// user dictionary of Google Pinyin: "xg" -> 香港 x907, 相关 x12. Unlike the
+// language model history, it keeps abbreviations apart ("y" -> 用 does not
+// make 用 come first for "yong"), and holds English and mixed words too.
+// Candidates for an input in this table come first, best Word::score first.
+class TypedCodeHistory {
+public:
+    static constexpr size_t MaxEntries = 60000;
+    static constexpr uint32_t MaxCount = 0xffffff;
+    // Words committed recently score higher, as if committed 10^RecentBoost
+    // times more, halving every RecentHalfLife commits (of any word), and the
+    // word committed last for a code 10^LastBoost times more still, halving
+    // every LastHalfLife commits. Tuned with
+    // scripts/typed-history-simulation.py of InsightKey on a real Google Pinyin
+    // user dictionary: when the user starts picking another word for a code, it
+    // comes first within a few commits, while words picked as often as before
+    // mostly keep their place.
+    static constexpr float RecentBoost = 3.0F;
+    static constexpr float RecentHalfLife = 5000.0F;
+    static constexpr float LastBoost = 2.0F;
+    static constexpr float LastHalfLife = 100.0F;
+
+    struct Word {
+        std::string word;
+        uint32_t count = 0;
+        // when last committed, 0 if never committed here (imported)
+        uint64_t stamp = 0;
+        // set by lookup(): log10(count), plus the boosts of recent commits
+        float score = 0;
+    };
+
+    // Letters typed, lowercase, without pinyin separators.
+    static std::string key(std::string_view input) {
+        std::string key;
+        key.reserve(input.size());
+        for (char c : input) {
+            if (c >= 'A' && c <= 'Z') {
+                key.push_back(static_cast<char>(c - 'A' + 'a'));
+            } else if (c >= 'a' && c <= 'z') {
+                key.push_back(c);
+            }
+        }
+        return key;
+    }
+
+    static bool isValid(std::string_view code, std::string_view word) {
+        return !code.empty() && code.size() <= 64 && !word.empty() &&
+               word.size() <= 256 &&
+               word.find_first_of("\t\n\r") == std::string_view::npos;
+    }
+
+    void learn(std::string_view input, std::string_view word,
+               uint32_t times = 1) {
+        auto code = key(input);
+        if (!isValid(code, word)) {
+            return;
+        }
+        auto &words = codes_[code];
+        auto iter = std::ranges::find_if(
+            words, [word](const Word &w) { return w.word == word; });
+        if (iter == words.end()) {
+            words.push_back({std::string(word), 0, 0});
+            iter = std::prev(words.end());
+            ++size_;
+        }
+        iter->count =
+            std::min<uint64_t>(uint64_t{iter->count} + times, MaxCount);
+        iter->stamp = ++clock_;
+        if (size_ > MaxEntries + MaxEntries / 10) {
+            evictOldest(MaxEntries);
+        }
+    }
+
+    // Undo one learn(), e.g. the commit was deleted right away.
+    void unlearn(std::string_view input, std::string_view word) {
+        auto iter = codes_.find(key(input));
+        if (iter == codes_.end()) {
+            return;
+        }
+        auto &words = iter->second;
+        auto w = std::ranges::find_if(
+            words, [word](const Word &w) { return w.word == word; });
+        if (w == words.end()) {
+            return;
+        }
+        if (w->count <= 1) {
+            words.erase(w);
+            --size_;
+            if (words.empty()) {
+                codes_.erase(iter);
+            }
+        } else {
+            --w->count;
+        }
+    }
+
+    void remove(std::string_view input, std::string_view word) {
+        auto iter = codes_.find(key(input));
+        if (iter == codes_.end()) {
+            return;
+        }
+        auto &words = iter->second;
+        auto removed = std::erase_if(
+            words, [word](const Word &w) { return w.word == word; });
+        size_ -= removed;
+        if (words.empty()) {
+            codes_.erase(iter);
+        }
+    }
+
+    void clear() {
+        codes_.clear();
+        size_ = 0;
+    }
+
+    bool empty() const { return codes_.empty(); }
+
+    // Words committed for input, best score (then most recent) first.
+    std::vector<Word> lookup(std::string_view input) const {
+        auto iter = codes_.find(key(input));
+        if (iter == codes_.end()) {
+            return {};
+        }
+        auto words = iter->second;
+        const auto last = std::ranges::max_element(
+            words, [](const Word &lhs, const Word &rhs) {
+                return lhs.stamp < rhs.stamp;
+            });
+        for (auto &w : words) {
+            w.score = std::log10(static_cast<float>(std::max(w.count, 1U)));
+            if (w.stamp == 0 || w.stamp > clock_) {
+                continue;
+            }
+            const auto age = static_cast<float>(clock_ - w.stamp);
+            w.score += RecentBoost * std::exp2(-age / RecentHalfLife);
+            if (&w == &*last) {
+                w.score += LastBoost * std::exp2(-age / LastHalfLife);
+            }
+        }
+        std::ranges::sort(words, [](const Word &lhs, const Word &rhs) {
+            if (lhs.score != rhs.score) {
+                return lhs.score > rhs.score;
+            }
+            return lhs.stamp > rhs.stamp;
+        });
+        return words;
+    }
+
+    // One entry per line: code<TAB>word<TAB>count<TAB>stamp
+    void load(std::istream &in) {
+        clear();
+        clock_ = 0;
+        std::string line;
+        while (std::getline(in, line)) {
+            size_t tabs[3];
+            size_t pos = 0;
+            bool ok = true;
+            for (auto &tab : tabs) {
+                tab = line.find('\t', pos);
+                if (tab == std::string::npos) {
+                    ok = false;
+                    break;
+                }
+                pos = tab + 1;
+            }
+            if (!ok) {
+                continue;
+            }
+            auto code = key(std::string_view(line).substr(0, tabs[0]));
+            auto word = line.substr(tabs[0] + 1, tabs[1] - tabs[0] - 1);
+            Word w;
+            try {
+                w.count = static_cast<uint32_t>(std::min<unsigned long>(
+                    std::stoul(line.substr(tabs[1] + 1, tabs[2] - tabs[1] - 1)),
+                    MaxCount));
+                w.stamp = std::stoull(line.substr(tabs[2] + 1));
+            } catch (...) {
+                continue;
+            }
+            if (w.count == 0 || !isValid(code, word)) {
+                continue;
+            }
+            w.word = std::move(word);
+            clock_ = std::max(clock_, w.stamp);
+            auto &words = codes_[code];
+            auto iter = std::ranges::find_if(
+                words, [&w](const Word &o) { return o.word == w.word; });
+            if (iter != words.end()) {
+                iter->count = std::max(iter->count, w.count);
+                iter->stamp = std::max(iter->stamp, w.stamp);
+                continue;
+            }
+            words.push_back(std::move(w));
+            ++size_;
+        }
+        if (size_ > MaxEntries) {
+            evictOldest(MaxEntries);
+        }
+    }
+
+    void save(std::ostream &out) const {
+        std::vector<std::pair<const std::string *, const Word *>> entries;
+        entries.reserve(size_);
+        for (const auto &[code, words] : codes_) {
+            for (const auto &w : words) {
+                entries.emplace_back(&code, &w);
+            }
+        }
+        std::ranges::sort(entries, [](const auto &lhs, const auto &rhs) {
+            return lhs.second->stamp < rhs.second->stamp;
+        });
+        for (const auto &[code, w] : entries) {
+            out << *code << '\t' << w->word << '\t' << w->count << '\t'
+                << w->stamp << '\n';
+        }
+    }
+
+private:
+    // Keep the keep most recent entries, less used first among never
+    // committed (imported) ones.
+    void evictOldest(size_t keep) {
+        using Age = std::pair<uint64_t, uint32_t>;
+        std::vector<Age> ages;
+        ages.reserve(size_);
+        for (const auto &[_, words] : codes_) {
+            for (const auto &w : words) {
+                ages.emplace_back(w.stamp, w.count);
+            }
+        }
+        if (ages.size() <= keep) {
+            return;
+        }
+        auto nth = ages.begin() + static_cast<long>(ages.size() - keep);
+        std::ranges::nth_element(ages, nth);
+        const Age minAge = *nth;
+        // of the entries as old as minAge, keep only as many as fit
+        auto ties = static_cast<size_t>(std::count(nth, ages.end(), minAge));
+        size_t tiesToKeep = ties;
+        size_ = 0;
+        for (auto iter = codes_.begin(); iter != codes_.end();) {
+            std::erase_if(iter->second, [&minAge, &tiesToKeep](const Word &w) {
+                const Age age{w.stamp, w.count};
+                if (age == minAge) {
+                    if (tiesToKeep == 0) {
+                        return true;
+                    }
+                    --tiesToKeep;
+                    return false;
+                }
+                return age < minAge;
+            });
+            size_ += iter->second.size();
+            if (iter->second.empty()) {
+                iter = codes_.erase(iter);
+            } else {
+                ++iter;
+            }
+        }
+    }
+
+    std::unordered_map<std::string, std::vector<Word>> codes_;
+    size_t size_ = 0;
+    uint64_t clock_ = 0;
+};
+
+} // namespace fcitx
+
+#endif // _PINYIN_TYPEDCODEHISTORY_H_
