+ * Fuzzy units for matching user input [typed] at [offset] as syllable
+ * initial + final. Returns nullopt if this match should be skipped.
+ *
+ * A keyboard correction replaces exactly one letter. With touch data for that
+ * letter, its cost is how much less likely the intended key was at the touch
+ * point than the key actually hit; keys the touch model did not consider are
+ * rejected. Without touch data, only same-row neighbors are accepted, at the
+ * original fixed cost.
+ */
+std::optional<size_t> matchFuzzyFactor(const PinyinContext *context,
+                                       std::string_view typed, size_t offset,
+                                       PinyinInitial initial, PinyinFinal final,
+                                       PinyinFuzzyFlags flags) {
+    if (!flags.test(PinyinFuzzyFlag::Correction)) {
+        return fuzzyFactor(flags);
+    }
+    const size_t base = fuzzyFactor(flags.unset(PinyinFuzzyFlag::Correction));
+    const std::string intended = PinyinEncoder::initialToString(initial) +
+                                 PinyinEncoder::finalToString(final);
+    if (intended.size() == typed.size()) {
+        size_t diffCount = 0;
+        size_t diff = 0;
+        for (size_t i = 0; i < typed.size(); i++) {
+            if (intended[i] != typed[i]) {
