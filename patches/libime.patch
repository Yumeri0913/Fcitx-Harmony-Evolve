+            if (alternatives && !alternatives->empty() &&
+                alternatives->front().first == got) {
+                const float typedScore = alternatives->front().second;
+                auto iter = std::find_if(
+                    alternatives->begin(), alternatives->end(),
+                    [want](const auto &item) { return item.first == want; });
+                if (iter == alternatives->end()) {
+                    return std::nullopt;
