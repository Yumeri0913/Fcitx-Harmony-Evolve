new file mode 100644
index 0000000..d0d5440
--- /dev/null
+++ b/src/picker.ts
@@ -0,0 +1,362 @@
+import type { Key } from './layout'
+import Backspace from 'bundle-text:../svg/gp/backspace.svg'
+import EmojiActivities from 'bundle-text:../svg/gp/emoji-activities.svg'
+import EmojiFlags from 'bundle-text:../svg/gp/emoji-flags.svg'
+import EmojiFood from 'bundle-text:../svg/gp/emoji-food.svg'
+import EmojiNature from 'bundle-text:../svg/gp/emoji-nature.svg'
+import EmojiObjects from 'bundle-text:../svg/gp/emoji-objects.svg'
+import EmojiPeople from 'bundle-text:../svg/gp/emoji-people.svg'
+import EmojiSymbols from 'bundle-text:../svg/gp/emoji-symbols.svg'
+import EmojiTravel from 'bundle-text:../svg/gp/emoji-travel.svg'
+import Recent from 'bundle-text:../svg/gp/recent.svg'
+import SymbolArrow from 'bundle-text:../svg/gp/symbol_arrow.svg'
+import SymbolBracket from 'bundle-text:../svg/gp/symbol_bracket.svg'
+import SymbolMath from 'bundle-text:../svg/gp/symbol_math.svg'
+import SymbolNumberPunctuation from 'bundle-text:../svg/gp/symbol_number_punctuation.svg'
+import SymbolOrdinal from 'bundle-text:../svg/gp/symbol_ordinal.svg'
+import SymbolOther from 'bundle-text:../svg/gp/symbol_other.svg'
+import TagFaces from 'bundle-text:../svg/gp/tag-faces.svg'
+import { emojiCategories, emoticonCategories } from './emojiData'
+import { renderRow } from './key'
+import { hidePopover, showPopover, showPopupKeyboard, updatePopupFocus } from './popover'
+import { googlePinyinSymbols, symbolLongPress } from './symbol'
+import { div, handleClick, press, release } from './util'
+import { backspace, haptic, isPopupOnKeyPress, LONG_PRESS_THRESHOLD, onTouchCancel, onTouchEnd, onTouchMove, onTouchStart, sendEvent } from './ux'
+
+// fcitx5-android's PickerWindow, used for Google Pinyin's symbol keyboard and the emoji and
+// emoticon pickers: category tabs in the bar, pages of keys that swipe sideways with a thin
+// page indicator, and a row of ABC, comma, a switch key, space, period and return.
+
+export type PickerKind = 'symbol' | 'emoji' | 'emoticon'
+
+interface Density {
+  pageSize: number
+  columnCount: number
+  rowCount: number
+  fontSize: number
+  backspace: boolean
+}
+
+// PickerPageUi.Density: High for symbols, Medium for emoji, Low for emoticons.
+const densities: Record<PickerKind, Density> = {
+  symbol: { pageSize: 28, columnCount: 10, rowCount: 3, fontSize: 19, backspace: true },
+  emoji: { pageSize: 20, columnCount: 7, rowCount: 3, fontSize: 23.7, backspace: true },
+  emoticon: { pageSize: 12, columnCount: 4, rowCount: 3, fontSize: 19, backspace: false },
+}
+
+interface Category {
+  // An svg icon or a text label.
+  icon: string
+  items: string[]
+}
+
+const emojiIcons = [TagFaces, EmojiPeople, EmojiNature, EmojiFood, EmojiTravel, EmojiActivities, EmojiObjects, EmojiSymbols, EmojiFlags]
+const symbolIcons = [SymbolNumberPunctuation, SymbolBracket, SymbolArrow, SymbolMath, SymbolOrdinal, SymbolOther]
+
+const RECENT_LIMIT = 30
+const recent: Record<PickerKind, string[]> = {
+  symbol: loadRecent('symbol'),
+  emoji: loadRecent('emoji'),
+  emoticon: loadRecent('emoticon'),
+}
+
+function recentKey(kind: PickerKind) {
+  return kind === 'emoji' ? 'fcitx-keyboard-recent-emoji' : `fcitx-keyboard-recent-${kind}`
+}
+
+function loadRecent(kind: PickerKind): string[] {
+  try {
+    const saved = JSON.parse(localStorage.getItem(recentKey(kind)) ?? '[]') as unknown
+    return Array.isArray(saved) ? saved.filter(item => typeof item === 'string') : []
+  }
+  catch {
+    return []
+  }
+}
+
+function addRecent(kind: PickerKind, text: string) {
+  recent[kind] = [text, ...recent[kind].filter(item => item !== text)].slice(0, RECENT_LIMIT)
+  try {
+    localStorage.setItem(recentKey(kind), JSON.stringify(recent[kind]))
+  }
+  catch {
+    // Recently used is a convenience.
+  }
+}
+
+function categories(kind: PickerKind): Category[] {
+  const data = kind === 'symbol'
+    ? googlePinyinSymbols.map((items, i) => ({ icon: symbolIcons[i], items }))
+    : kind === 'emoji'
+      ? emojiCategories.map((category, i) => ({ icon: emojiIcons[i] ?? category.label, items: category.items }))
+      : emoticonCategories.map(category => ({ icon: category.label, items: category.items }))
+  return [{ icon: Recent, items: recent[kind] }, ...data]
+}
+
+let currentKind: PickerKind = 'symbol'
+let currentCategories: Category[] = []
+// First page of each category, and the total.
+let pageStarts: number[] = []
+let currentCategory = -1
+
+function bar() {
+  return document.querySelector('.fcitx-keyboard-picker-bar') as HTMLElement
+}
+
+function pager() {
+  return document.querySelector('.fcitx-keyboard-picker-pager') as HTMLElement
+}
+
+// Symbol keys: commit, preview while pressed, and Google Pinyin's long press options.
+function renderItem(kind: PickerKind, text: string) {
+  const item = div('fcitx-keyboard-picker-key')
+  const label = div('fcitx-keyboard-picker-key-label')
+  label.textContent = text
+  item.appendChild(label)
+  let startX = 0
+  let startY = 0
+  let timer: number | null = null
+  let longPress = -2
+  const options = kind === 'symbol' ? symbolLongPress[text] : undefined
+  const preview = kind === 'symbol' && isPopupOnKeyPress()
+  item.addEventListener('touchstart', (event) => {
+    const touch = event.changedTouches[0]
+    startX = touch.clientX
+    startY = touch.clientY
+    longPress = -2
+    haptic()
+    press(item)
+    if (preview) {
+      showPopover(item, text)
+    }
+    if (options) {
+      timer = window.setTimeout(() => {
+        timer = null
+        longPress = showPopupKeyboard(item, [text, ...options])
+      }, LONG_PRESS_THRESHOLD)
+    }
+  })
+  item.addEventListener('touchmove', (event) => {
+    const touch = event.changedTouches[0]
+    if (longPress >= -1) {
+      longPress = updatePopupFocus(touch.clientX, touch.clientY)
+      return
+    }
+    if (Math.abs(touch.clientX - startX) > 10 || Math.abs(touch.clientY - startY) > 10) {
+      if (timer) {
+        clearTimeout(timer)
+        timer = null
+      }
+      release(item)
+      hidePopover()
+    }
+  })
+  const end = (event: TouchEvent, cancelled: boolean) => {
+    if (timer) {
+      clearTimeout(timer)
+      timer = null
+    }
+    const wasPressed = item.classList.contains('fcitx-keyboard-pressed')
+    release(item)
+    if (longPress >= -1) {
+      hidePopover()
+      if (!cancelled && longPress >= 0) {
+        commit(kind, [text, ...options!][longPress])
+      }
+      return
+    }
+    hidePopover(preview ? 100 : 0)
+    const touch = event.changedTouches[0]
+    if (!cancelled && wasPressed && Math.abs(touch.clientX - startX) <= 10) {
+      commit(kind, text)
+    }
+  }
+  item.addEventListener('touchend', event => end(event, false))
+  item.addEventListener('touchcancel', event => end(event, true))
+  return item
+}
+
+function commit(kind: PickerKind, text: string) {
+  sendEvent({ type: 'COMMIT', data: text })
+  addRecent(kind, text)
+}
+
+function renderBackspace() {
+  const key = div('fcitx-keyboard-picker-key')
+  key.classList.add('fcitx-keyboard-picker-backspace')
+  key.innerHTML = Backspace
+  let timer: number | null = null
+  let repeat: number | null = null
+  const stop = () => {
+    timer && clearTimeout(timer)
+    repeat && clearInterval(repeat)
+    timer = null
+    repeat = null
+    release(key)
+  }
+  key.addEventListener('touchstart', () => {
+    haptic()
+    press(key)
+    backspace()
+    timer = window.setTimeout(() => {
+      timer = null
+      repeat = window.setInterval(backspace, 50)
+    }, LONG_PRESS_THRESHOLD)
+  })
+  key.addEventListener('touchend', stop)
+  key.addEventListener('touchcancel', stop)
+  return key
+}
+
+function renderPage(kind: PickerKind, items: string[]) {
+  const density = densities[kind]
+  const page = div('fcitx-keyboard-picker-page')
+  page.style.fontSize = `${density.fontSize}px`
+  for (let row = 0; row < density.rowCount; ++row) {
+    const rowElement = div('fcitx-keyboard-picker-row')
+    const last = row === density.rowCount - 1
+    const count = density.columnCount - (last && density.backspace ? density.columnCount * density.rowCount - density.pageSize : 0)
+    if (last && density.backspace) {
+      // The last row packs toward the backspace key.
+      rowElement.classList.add('fcitx-keyboard-picker-row-last')
+    }
+    for (let column = 0; column < count; ++column) {
+      const text = items[row * density.columnCount + column]
+      const cell = text === undefined ? div('fcitx-keyboard-picker-key') : renderItem(kind, text)
+      cell.style.width = `${100 / density.columnCount}%`
+      if (kind === 'emoticon') {
+        cell.classList.add('fcitx-keyboard-picker-emoticon')
+      }
+      rowElement.appendChild(cell)
+    }
+    if (last && density.backspace) {
+      const bs = renderBackspace()
+      bs.style.width = '15%'
+      rowElement.appendChild(bs)
+    }
+    page.appendChild(rowElement)
+  }
+  return page
+}
+
+function renderTabs() {
+  const tabs = bar()
+  tabs.innerHTML = ''
+  currentCategories.forEach((category, i) => {
+    const tab = div('fcitx-keyboard-picker-tab')
+    if (category.icon.startsWith('<svg')) {
+      tab.innerHTML = category.icon
+    }
+    else {
+      tab.textContent = category.icon
+      tab.classList.add('fcitx-keyboard-picker-tab-text')
+    }
+    handleClick(tab, () => selectCategory(i))
+    tabs.appendChild(tab)
+  })
+}
+
+function selectCategory(index: number) {
+  const element = pager()
+  element.scrollTo({ left: pageStarts[index] * element.clientWidth })
+  updateIndicator()
+}
+
+function updateIndicator() {
+  const element = pager()
+  const width = element.clientWidth || 1
+  const page = Math.round(element.scrollLeft / width)
+  let category = 0
+  while (category + 1 < currentCategories.length && pageStarts[category + 1] <= page) {
+    category++
+  }
+  const pages = pageStarts[category + 1] - pageStarts[category]
+  const thumb = document.querySelector('.fcitx-keyboard-picker-indicator-thumb') as HTMLElement
+  thumb.style.width = `${100 / Math.max(1, pages)}%`
+  thumb.style.left = `${(page - pageStarts[category]) * 100 / Math.max(1, pages)}%`
+  if (category !== currentCategory) {
+    currentCategory = category
+    bar().querySelectorAll('.fcitx-keyboard-picker-tab').forEach((tab, i) => {
+      tab.classList.toggle('fcitx-keyboard-picker-tab-active', i === category)
+      if (i === category) {
+        tab.scrollIntoView({ block: 'nearest', inline: 'nearest' })
+      }
+    })
+  }
+}
+
+function bottomRow(kind: PickerKind): Key[] {
+  const switchKey: Key = kind === 'symbol'
+    ? { type: 'layer', label: '', layer: 'number', icon: 'number-pad' }
+    : { type: 'picker', label: kind === 'emoji' ? ':-)' : '', picker: kind === 'emoji' ? 'emoticon' : 'emoji', icon: kind === 'emoji' ? undefined : 'tag-faces' }
+  return [
+    { type: 'layer', label: 'ABC', layer: 'default', flex: '1.5' },
+    { type: 'key', label: ',', key: ',', code: 'Comma', variant: 'alternative' },
+    { ...switchKey, flex: '1' },
+    { type: 'space', flex: '4' },
+    { type: 'key', label: '.', key: '.', code: 'Period', variant: 'alternative' },
+    { type: 'enter', flex: '1.5' },
+  ]
+}
+
+export function showPicker(mode: 'symbol' | 'emoji') {
+  // Emoji and emoticons share the comma menu's entry; the switch key flips between them.
+  const kind: PickerKind = mode === 'symbol' ? 'symbol' : (currentKind === 'emoticon' ? 'emoticon' : 'emoji')
+  fillPicker(kind)
+}
+
+export function switchPicker(kind: PickerKind) {
+  fillPicker(kind)
+}
+
+function fillPicker(kind: PickerKind) {
+  currentKind = kind
+  currentCategories = categories(kind)
+  const density = densities[kind]
+  const element = pager()
+  element.innerHTML = ''
+  pageStarts = []
+  let pages = 0
+  for (const category of currentCategories) {
+    pageStarts.push(pages)
+    const count = Math.max(1, Math.ceil(category.items.length / density.pageSize))
+    for (let i = 0; i < count; ++i) {
+      element.appendChild(renderPage(kind, category.items.slice(i * density.pageSize, (i + 1) * density.pageSize)))
+    }
+    pages += count
+  }
+  pageStarts.push(pages)
+  renderTabs()
+  const keyboard = document.querySelector('.fcitx-keyboard-picker-keyboard') as HTMLElement
+  keyboard.innerHTML = ''
+  keyboard.appendChild(renderRow({ keys: bottomRow(kind) }, { layer: 'picker', locked: false }))
+  currentCategory = -1
+  // fcitx5-android opens the symbol keyboard on its first category, the others on recently
+  // used when there is any.
+  const start = kind === 'symbol' || recent[kind].length === 0 ? 1 : 0
+  requestAnimationFrame(() => selectCategory(start))
+  selectCategory(start)
+}
+
+export function renderPickerBar() {
+  return div('fcitx-keyboard-picker-bar')
+}
+
+export function renderPicker() {
+  const picker = div('fcitx-keyboard-picker')
+  const element = div('fcitx-keyboard-picker-pager')
+  let scrollTimer: number | null = null
+  element.addEventListener('scroll', () => {
+    scrollTimer && clearTimeout(scrollTimer)
+    scrollTimer = window.setTimeout(updateIndicator, 50)
+  })
+  const indicator = div('fcitx-keyboard-picker-indicator')
+  indicator.appendChild(div('fcitx-keyboard-picker-indicator-thumb'))
+  const keyboard = div('fcitx-keyboard-picker-keyboard')
+  keyboard.addEventListener('touchstart', onTouchStart)
+  keyboard.addEventListener('touchmove', onTouchMove)
+  keyboard.addEventListener('touchend', onTouchEnd)
+  keyboard.addEventListener('touchcancel', onTouchCancel)
+  picker.append(element, indicator, keyboard)
+  return picker
+}
