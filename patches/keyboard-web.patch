+import type { Key, Layout, LongPress, Row, Swipe } from './layout'
+
+// Google Pinyin 4.x look, ported from fcitx5-android TextKeyboard/NumberKeyboard
+// (InsightKey fork) and the fcitx5-ios uipanel port. Each row is 10 units wide.
+
+// Long press alternates, from fcitx5-android PopupPreset.kt (based on fcitx5 longpress.cpp).
+
+const popupPreset: Record<string, string[]> = {
+  'q': ['1', 'Q'],
+  'w': ['2', 'W'],
+  'e': ['3', 'E', 'ê', 'ë', 'ē', 'é', 'ě', 'è', 'ė', 'ę', 'ȩ', 'ḝ', 'ə'],
