diff --git a/src/emoji.ts b/src/emoji.ts
new file mode 100644
index 0000000..999bcf4
--- /dev/null
+++ b/src/emoji.ts
@@ -0,0 +1,107 @@
+import type { PickerCategory } from './emojiData'
+import { popDisplayModeStack } from './display'
+import { emojiCategories, emoticonCategories } from './emojiData'
+import { div, enableScroll, handleClick, press, release } from './util'
+import { backspace, sendEvent } from './ux'
+
+// Emoji and emoticon (颜文字) picker like fcitx5-android's PickerWindow: a grid of the
+// current category, and a bottom row with back, category tabs, kind switch and backspace.
+
+const RECENT_KEY = 'fcitx-keyboard-recent-emoji'
+const RECENT_LIMIT = 32
+
+let emoticon = false
+let recent: string[] = loadRecent()
+
+function loadRecent(): string[] {
+  try {
+    const saved = JSON.parse(localStorage.getItem(RECENT_KEY) ?? '[]') as unknown
+    return Array.isArray(saved) ? saved.filter(item => typeof item === 'string') : []
+  }
+  catch {
+    return []
+  }
+}
+
+function addRecent(text: string) {
+  recent = [text, ...recent.filter(item => item !== text)].slice(0, RECENT_LIMIT)
+  try {
+    localStorage.setItem(RECENT_KEY, JSON.stringify(recent))
+  }
+  catch {
+    // Recently used is a convenience.
+  }
+}
+
+// Recently used comes first, like fcitx5-android.
+function categories(): PickerCategory[] {
+  return [{ label: '⟳', items: recent }, ...(emoticon ? emoticonCategories : emojiCategories)]
+}
+
+function renderTabs() {
+  const tabs = document.querySelector('.fcitx-keyboard-emoji-tabs') as HTMLElement
+  tabs.innerHTML = ''
+  categories().forEach((category, i) => {
+    const tab = div('fcitx-keyboard-emoji-tab')
+    tab.textContent = category.label
+    handleClick(tab, () => selectEmojiCategory(i))
+    tabs.appendChild(tab)
+  })
+  const kind = document.querySelector('.fcitx-keyboard-emoji-kind') as HTMLElement
+  kind.textContent = emoticon ? '😀' : '^_^'
+}
+
+// index -1: recently used if any, otherwise the first category.
+export function selectEmojiCategory(index: number) {
+  renderTabs()
+  const all = categories()
+  if (index < 0) {
+    index = recent.length > 0 ? 0 : 1
+  }
+  const grid = document.querySelector('.fcitx-keyboard-emoji-grid') as HTMLElement
+  grid.classList.toggle('fcitx-keyboard-emoticon-grid', emoticon)
+  grid.innerHTML = ''
+  grid.scroll({ top: 0 })
+  for (const text of all[index].items) {
+    const item = div('fcitx-keyboard-emoji-item')
+    item.textContent = text
+    handleClick(item, () => {
+      sendEvent({ type: 'COMMIT', data: text })
+      addRecent(text)
+    })
+    grid.appendChild(item)
+  }
+  document.querySelectorAll('.fcitx-keyboard-emoji-tab').forEach((tab, i) => {
+    i === index ? press(tab) : release(tab)
+    if (i === index) {
+      tab.scrollIntoView({ block: 'nearest', inline: 'nearest' })
+    }
+  })
+}
+
+function renderButton(klass: string, label: string, handler: () => void) {
+  const button = div('fcitx-keyboard-emoji-button')
+  button.classList.add(klass)
+  button.textContent = label
+  handleClick(button, handler)
+  return button
+}
+
+export function renderEmojiPicker() {
+  const picker = div('fcitx-keyboard-emoji-picker')
+  const grid = div('fcitx-keyboard-emoji-grid')
+  enableScroll(grid)
+  const bottom = div('fcitx-keyboard-emoji-bottom')
+  const tabs = div('fcitx-keyboard-emoji-tabs')
+  enableScroll(tabs)
+  bottom.appendChild(renderButton('fcitx-keyboard-emoji-back', 'ABC', () => popDisplayModeStack()))
+  bottom.appendChild(tabs)
+  bottom.appendChild(renderButton('fcitx-keyboard-emoji-kind', '^_^', () => {
+    emoticon = !emoticon
+    selectEmojiCategory(1)
+  }))
+  bottom.appendChild(renderButton('fcitx-keyboard-emoji-backspace', '⌫', () => backspace()))
+  picker.appendChild(grid)
+  picker.appendChild(bottom)
+  return picker
+}
