+}
+
+const rows = [
+  ['q1', 'w2', 'e3', 'r4', 't5', 'y6', 'u7', 'i8', 'o9', 'p0'],
+  ['a@', 's*', 'd+', 'f-', 'g=', 'h/', 'j#', 'k(', 'l)'],
+  ['z\'', 'x:', 'c"', 'v?', 'b!', 'n~', 'm\\'],
+]
+
+function swipe(label: string): Swipe {
+  return { label, actions: [{ type: 'key', key: label }] }
+}
+
+function longPress(label: string): LongPress | undefined {
+  const cells = popupPreset[label]
+  if (!cells) {
+    return undefined
+  }
+  return { cells: cells.map(swipe), index: 0 }
+}
+
+function alphabet(letter: string, alt: string): Key {
+  return {
+    type: 'key',
+    label: letter,
+    key: letter,
+    code: `Key${letter.toUpperCase()}`,
+    subLabel: { bottom: alt },
+    // Google Pinyin inputs the small symbol by swiping down, fcitx by swiping up.
+    swipeUp: swipe(alt),
+    swipeDown: swipe(alt),
+    longPress: longPress(letter),
+  }
+}
+
+function textLayer(upper: boolean): Row[] {
+  const letterRows: Key[][] = rows.map(row => row.map(([letter, alt]) =>
+    alphabet(upper ? letter.toUpperCase() : letter, alt)))
+  return [
+    { keys: letterRows[0] },
+    { keys: [{ type: 'placeholder', flex: '0.5' }, ...letterRows[1], { type: 'placeholder', flex: '0.5' }] },
+    { keys: [{ type: 'shift', flex: '1.5' }, ...letterRows[2], { type: 'backspace', flex: '1.5' }] },
+    { keys: [
+      // Google Pinyin's ?123 opens the symbol keyboard; its 12/34 key opens the number pad.
+      { type: 'symbol', label: '?123', flex: '1.5' },
+      { type: 'key', label: ',', key: ',', code: 'Comma', variant: 'alternative', commaMenu: true },
+      { type: 'globe' },
+      { type: 'space', flex: '4' },
+      { type: 'key', label: '.', key: '.', code: 'Period', variant: 'alternative', longPress: longPress('.') },
+      { type: 'enter', flex: '1.5' },
+    ] },
+  ]
+}
+
+function numPad(label: string, flex: string): Key {
+  return { type: 'key', label, key: label, code: `Numpad${label}`, flex }
+}
+
+function numPadSymbol(label: string, flex = '1.5'): Key {
+  return { type: 'key', label, key: label, variant: 'alternative', flex }
+}
+
+const digitFlex = (7 / 3).toFixed(4)
+
+const numberRows: Row[] = [
+  { keys: [numPadSymbol('+'), numPad('1', digitFlex), numPad('2', digitFlex), numPad('3', digitFlex), numPadSymbol('/')] },
+  { keys: [numPadSymbol('-'), numPad('4', digitFlex), numPad('5', digitFlex), numPad('6', digitFlex), { type: 'key', label: '␣', key: ' ', code: 'Space', variant: 'alternative', flex: '1.5' }] },
+  { keys: [numPadSymbol('*'), numPad('7', digitFlex), numPad('8', digitFlex), numPad('9', digitFlex), { type: 'backspace', flex: '1.5' }] },
+  { keys: [
+    { type: 'layer', label: 'ABC', layer: 'default', flex: '1.5' },
+    numPadSymbol(',', '1'),
+    { type: 'symbol', label: '!?#', flex: '1.3333' },
+    numPad('0', '2.3334'),
+    { type: 'key', label: '=', key: '=', flex: '1.3333' },
+    numPadSymbol('.', '1'),
+    { type: 'enter', flex: '1.5' },
+  ] },
+]
+
+export const googlePinyinLayout: Layout = {
+  layers: [
+    { id: 'default', rows: textLayer(false) },
+    { id: 'shift', rows: textLayer(true) },
+    { id: 'number', rows: numberRows },
+  ],
+}
