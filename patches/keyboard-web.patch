+/* Clipboard history, like fcitx5-android's clipboard window. */
+.fcitx-keyboard-clipboard {
+  display: flex;
+  flex-direction: column;
+}
+
+.fcitx-keyboard-clipboard-header {
+  display: flex;
+  height: 40px;
+  align-items: center;
+  border-bottom: 1px solid var(--fcitx-divider);
+}
+
+.fcitx-keyboard-clipboard-paste-slot {
+  flex: 1;
+}
+
+.fcitx-keyboard-clipboard-button {
+  padding: 0 14px;
+  height: 100%;
+  display: flex;
+  align-items: center;
+  font-size: 15px;
+  color: var(--fcitx-alt-key-text);
+}
+
+.fcitx-keyboard-clipboard-button:active {
+  background-color: var(--fcitx-key-press);
+}
+
+.fcitx-keyboard-clipboard-list {
+  flex: 1;
+  display: grid;
+  grid-template-columns: repeat(2, 1fr);
+  grid-auto-rows: min-content;
+  gap: 6px;
+  padding: 6px;
+  overflow: hidden auto;
+  scrollbar-width: none;
+}
+
+.fcitx-keyboard-clipboard-entry {
+  padding: 8px 10px;
+  border-radius: var(--fcitx-key-radius);
+  background-color: var(--fcitx-key-background);
+  box-shadow: 0 1px var(--fcitx-key-shadow);
+  font-size: 14px;
+  color: var(--fcitx-key-text);
+}
+
+.fcitx-keyboard-clipboard-entry:active {
+  background-image: linear-gradient(var(--fcitx-key-press), var(--fcitx-key-press));
+}
+
+.fcitx-keyboard-clipboard-pinned {
+  border-left: 3px solid var(--fcitx-accent-key-background);
+}
+
+.fcitx-keyboard-clipboard-text {
+  display: -webkit-box;
+  -webkit-line-clamp: 4;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+  word-break: break-all;
+  white-space: pre-wrap;
+}
+
+.fcitx-keyboard-clipboard-empty {
+  grid-column: 1 / -1;
+  padding: 16px;
+  font-size: 14px;
+  color: var(--fcitx-alt-key-text);
+}
