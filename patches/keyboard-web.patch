diff --git a/src/clipboard.ts b/src/clipboard.ts
new file mode 100644
index 0000000..ba50c99
--- /dev/null
+++ b/src/clipboard.ts
@@ -0,0 +1,104 @@
+import type { ClipboardEntry } from './api'
+import DeleteSweep from 'bundle-text:../svg/gp/delete-sweep.svg'
+import Pin from 'bundle-text:../svg/gp/pin.svg'
+import { showContextmenu } from './contextmenu'
+import { div, enableScroll, handleClick, renderToolbarButton, tr } from './util'
+import { LONG_PRESS_THRESHOLD, sendEvent } from './ux'
+
+// Clipboard history like fcitx5-android's clipboard window: the title bar has the delete all
+// button, entries are cards in two staggered columns with pinned ones first, tap to paste,
+// long press to pin or delete. The host keeps the history and overlays HarmonyOS's system
+// paste button in the title bar, the only way for a keyboard to read the clipboard.
+
+function renderEntry(entry: ClipboardEntry) {
+  const item = div('fcitx-keyboard-clipboard-entry')
+  const text = div('fcitx-keyboard-clipboard-text')
+  text.textContent = entry.text
+  item.appendChild(text)
+  if (entry.pinned) {
+    const pin = div('fcitx-keyboard-clipboard-pin')
+    pin.innerHTML = Pin
+    item.appendChild(pin)
+  }
+
+  let timer: number | null = null
+  let longPressed = false
+  item.addEventListener('touchstart', () => {
+    longPressed = false
+    timer = window.setTimeout(() => {
+      timer = null
+      longPressed = true
+      showContextmenu(item, [
+        {
+          text: entry.pinned ? tr('Unpin', '取消置顶') : tr('Pin', '置顶'),
+          callback() { sendEvent({ type: 'CLIPBOARD_PIN', data: { id: entry.id, pinned: !entry.pinned } }) },
+        },
+        {
+          text: tr('Delete', '删除'),
+          callback() { sendEvent({ type: 'CLIPBOARD_DELETE', data: entry.id }) },
+        },
+      ])
+    }, LONG_PRESS_THRESHOLD)
+  })
+  const cancel = () => {
+    if (timer) {
+      clearTimeout(timer)
+      timer = null
+    }
+  }
+  item.addEventListener('touchmove', cancel)
+  item.addEventListener('touchend', cancel)
+  item.addEventListener('touchcancel', cancel)
+  handleClick(item, () => {
+    if (!longPressed) {
+      sendEvent({ type: 'COMMIT', data: entry.text })
+    }
+  })
+  return item
+}
+
+export function setClipboard(entries: ClipboardEntry[]) {
+  const list = document.querySelector('.fcitx-keyboard-clipboard-list') as HTMLElement
+  list.innerHTML = ''
+  if (entries.length === 0) {
+    const empty = div('fcitx-keyboard-clipboard-empty')
+    empty.textContent = tr(
+      'Text copied or cut with the keyboard\'s text editing panel appears here. Tap Paste to add what is on the system clipboard.',
+      '用键盘的文本编辑面板复制或剪切的文字会出现在这里。点“粘贴”可以加入系统剪贴板的内容。',
+    )
+    list.appendChild(empty)
+    return
+  }
+  const sorted = [...entries.filter(e => e.pinned), ...entries.filter(e => !e.pinned)]
+  // Two staggered columns, filled in turn like StaggeredGridLayoutManager.
+  const columns = [div('fcitx-keyboard-clipboard-column'), div('fcitx-keyboard-clipboard-column')]
+  list.append(...columns)
+  // The panel may be hidden, so estimate heights: up to 4 lines of about 10 characters.
+  const heights = [0, 0]
+  for (const entry of sorted) {
+    const column = heights[0] <= heights[1] ? 0 : 1
+    columns[column].appendChild(renderEntry(entry))
+    const lines = entry.text.split('\n').reduce((sum, line) => sum + Math.max(1, Math.ceil(line.length / 10)), 0)
+    heights[column] += Math.min(4, lines) + 1
+  }
+}
+
+export function clipboardBarButtons() {
+  // Covered by the host's system paste button.
+  const pasteSlot = div('fcitx-keyboard-clipboard-paste-slot')
+  const deleteAll = renderToolbarButton(DeleteSweep)
+  handleClick(deleteAll, () => {
+    showContextmenu(deleteAll, [
+      { text: tr('Delete all except pinned', '删除所有未置顶的条目'), callback() { sendEvent({ type: 'CLIPBOARD_CLEAR' }) } },
+    ])
+  })
+  return [pasteSlot, deleteAll]
+}
+
+export function renderClipboard() {
+  const clipboard = div('fcitx-keyboard-clipboard')
+  const list = div('fcitx-keyboard-clipboard-list')
+  enableScroll(list)
+  clipboard.appendChild(list)
+  return clipboard
+}
