diff --git a/src/clipboard.ts b/src/clipboard.ts
new file mode 100644
index 0000000..d11d69b
--- /dev/null
+++ b/src/clipboard.ts
@@ -0,0 +1,97 @@
+import type { ClipboardEntry } from './api'
+import { showContextmenu } from './contextmenu'
+import { popDisplayModeStack } from './display'
+import { div, enableScroll, handleClick } from './util'
+import { LONG_PRESS_THRESHOLD, sendEvent } from './ux'
+
+// Clipboard history like fcitx5-android's clipboard window: pinned entries first, tap to
+// paste, long press to pin or delete. The host keeps the history and overlays a system
+// paste button on the left of the header, which HarmonyOS needs to read the clipboard.
+
+function isChinese() {
+  return navigator.language.startsWith('zh')
+}
+
+function renderEntry(entry: ClipboardEntry) {
+  const item = div('fcitx-keyboard-clipboard-entry')
+  if (entry.pinned) {
+    item.classList.add('fcitx-keyboard-clipboard-pinned')
+  }
+  const text = div('fcitx-keyboard-clipboard-text')
+  text.textContent = entry.text
+  item.appendChild(text)
+
+  let timer: number | null = null
+  let longPressed = false
+  item.addEventListener('touchstart', () => {
+    longPressed = false
+    timer = window.setTimeout(() => {
+      timer = null
+      longPressed = true
+      const zh = isChinese()
+      showContextmenu(item, [
+        {
+          text: entry.pinned ? (zh ? '取消置顶' : 'Unpin') : (zh ? '置顶' : 'Pin'),
+          callback() { sendEvent({ type: 'CLIPBOARD_PIN', data: { id: entry.id, pinned: !entry.pinned } }) },
+        },
+        {
+          text: zh ? '删除' : 'Delete',
+          callback() { sendEvent({ type: 'CLIPBOARD_DELETE', data: entry.id }) },
+        },
+      ])
+    }, LONG_PRESS_THRESHOLD)
+  })
+  const cancel = () => {
+    if (timer) {
+      clearTimeout(timer)
+      timer = null
+    }
+  }
+  item.addEventListener('touchmove', cancel)
+  item.addEventListener('touchend', cancel)
+  item.addEventListener('touchcancel', cancel)
+  handleClick(item, () => {
+    if (!longPressed) {
+      sendEvent({ type: 'COMMIT', data: entry.text })
+    }
+  })
+  return item
+}
+
+export function setClipboard(entries: ClipboardEntry[]) {
+  const list = document.querySelector('.fcitx-keyboard-clipboard-list') as HTMLElement
+  list.innerHTML = ''
+  if (entries.length === 0) {
+    const empty = div('fcitx-keyboard-clipboard-empty')
+    empty.textContent = isChinese()
+      ? '用键盘的编辑面板复制或剪切的文字会出现在这里。点左上角的粘贴按钮可以加入系统剪贴板的内容。'
+      : 'Text copied or cut with the keyboard\'s editing panel appears here. Tap paste to add the system clipboard.'
+    list.appendChild(empty)
+    return
+  }
+  const sorted = [...entries.filter(e => e.pinned), ...entries.filter(e => !e.pinned)]
+  for (const entry of sorted) {
+    list.appendChild(renderEntry(entry))
+  }
+}
+
+export function renderClipboard() {
+  const zh = isChinese()
+  const clipboard = div('fcitx-keyboard-clipboard')
+  const header = div('fcitx-keyboard-clipboard-header')
+  // Left part is covered by the host's system paste button.
+  header.appendChild(div('fcitx-keyboard-clipboard-paste-slot'))
+  const clear = div('fcitx-keyboard-clipboard-button')
+  clear.textContent = zh ? '清空' : 'Clear'
+  handleClick(clear, () => sendEvent({ type: 'CLIPBOARD_CLEAR' }))
+  const back = div('fcitx-keyboard-clipboard-button')
+  back.textContent = zh ? '返回' : 'Back'
+  handleClick(back, () => popDisplayModeStack())
+  header.appendChild(clear)
+  header.appendChild(back)
+  const list = div('fcitx-keyboard-clipboard-list')
+  enableScroll(list)
+  clipboard.appendChild(header)
+  clipboard.appendChild(list)
+  return clipboard
+}
