+  'H': ['/', 'h'],
+  'J': ['#', 'j'],
+  'K': ['(', 'k'],
+  'L': [')', 'l', 'Ł'],
+  'Z': ['\'', 'z', '`', 'Ž', 'Ź', 'Ż'],
+  'X': [':', 'x'],
